{
  "id": "parley",
  "name": "Parley",
  "description": "Board-scoped coordination runtime and tools for OpenClaw agents.",
  "version": "0.1.0-alpha.3",
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "repoRoot": { "type": "string" },
      "parleyRoot": { "type": "string" },
      "parleyRuntimeRoot": { "type": "string" },
      "parleyRegistry": { "type": "object", "additionalProperties": true },
      "parleyBoards": { "type": "object", "additionalProperties": true },
      "parleyDefaultBoards": { "type": "object", "additionalProperties": true },
      "parleyAgents": { "type": "object", "additionalProperties": true },
      "parleyCallerRuntimeRef": { "type": "object", "additionalProperties": true }
    }
  }
}
