{
  "name": "@nkuhanas/parley",
  "version": "0.1.0-alpha.4",
  "type": "module",
  "description": "Board-scoped coordination runtime and OpenClaw tools for AI agents",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./plugin": "./plugin.js",
    "./openclaw": "./src/adapters/openclaw/index.js",
    "./core/*": "./src/core/*",
    "./schemas": "./src/schemas/index.js",
    "./schemas/*": "./src/schemas/*",
    "./adapters/openclaw/*": "./src/adapters/openclaw/*",
    "./src/*": "./src/*"
  },
  "scripts": {
    "test": "node --test"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nkuhanas/Parley.git"
  },
  "bugs": {
    "url": "https://github.com/nkuhanas/Parley/issues"
  },
  "homepage": "https://github.com/nkuhanas/Parley#readme",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "index.js",
    "plugin.js",
    "openclaw.plugin.json",
    "src/",
    "docs/",
    "examples/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md"
  ],
  "keywords": [
    "openclaw",
    "plugin",
    "agents",
    "coordination",
    "workflow"
  ],
  "openclaw": {
    "extensions": [
      "./plugin.js"
    ],
    "compat": {
      "pluginApi": ">=2026.4.27",
      "minGatewayVersion": "2026.4.27"
    },
    "build": {
      "openclawVersion": "2026.4.27",
      "pluginSdkVersion": "2026.4.27"
    }
  }
}
